# Leave blank for same-origin API calls. Vite proxies /api locally;
# production needs a same-origin reverse proxy to the backend.
VITE_API_BASE_URL=

# Optional local Vite proxy target when the backend is not on 127.0.0.1:8080.
DEV_API_PROXY_TARGET=http://127.0.0.1:8080

# Build-time public analytics configuration. Leave disabled for ordinary local builds.
# Use the EU project's client-visible project token, never a personal API key.
# In PostHog Project settings > Web Analytics, "Enable cookieless tracking" must be ON.
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
